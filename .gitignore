# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
ENV/
env/

# Packaging and distribution artifacts (Hatchling / Wheel / PIP)
build/
dist/
wheels/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# ==============================================================================
# 2. Environment Configuration & Secrets (pydantic-settings)
# ==============================================================================
