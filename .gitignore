.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Mypy & Ruff
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# Other QA tools
.tox/
.nox/
.cache/

