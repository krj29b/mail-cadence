# Copy to /etc/mail-cadence/mail-cadence.env, owner root:mail-cadence, mode 0640.
# Read by both systemd units (EnvironmentFile=). Variable reference: README.md.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_START_TLS=true
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change-me

ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Uncomment if the reverse proxy runs on another machine (its IP), so the login limit
# sees real client IPs from X-Forwarded-For:
# FORWARDED_ALLOW_IPS=10.0.0.5
