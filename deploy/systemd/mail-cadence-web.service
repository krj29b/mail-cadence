# Web panel on 127.0.0.1:8000, meant to sit behind a reverse proxy with HTTPS
# (deploy/nginx/mail-cadence.conf). See docs/DEPLOYMENT.md.
[Unit]
Description=MailCadence web panel
Documentation=https://github.com/krj29b/mail-cadence/blob/master/docs/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=mail-cadence
Group=mail-cadence
StateDirectory=mail-cadence
StateDirectoryMode=0700
WorkingDirectory=/var/lib/mail-cadence
EnvironmentFile=/etc/mail-cadence/mail-cadence.env
Environment=MAIL_CADENCE_DB=/var/lib/mail-cadence/mail_cadence.db
Environment=MAIL_CADENCE_TEMPLATE_DIR=/etc/mail-cadence/templates
# One process only: dispatch jobs and the login limit are per process.
ExecStart=/opt/mail-cadence/venv/bin/mail-cadence serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5s

# --- Sandboxing (check with: systemd-analyze security mail-cadence-web) ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
